"туннель: стек %@, MTU %@, kill switch %@, исключение push Apple %@" = "tunnel: stack %@, MTU %@, kill switch %@, Apple push exclusion %@";
"выход для проверок приложения открыт" = "the app's way out for tests is open";
"выход для проверок не открылся (%@): туннель без него" = "the way out for tests did not open (%@): the tunnel runs without it";
