// Версия Personal Tunnel. Номер сборки должен только расти: 1.5.0 была сборкой 179.
MARKETING_VERSION = 3.0.1
CURRENT_PROJECT_VERSION = 213
// Номер беты: «3.0, beta 1 (212)» внизу настроек. Пусто у релизной сборки: «3.0 (212)».
BETA_NUMBER = 1

// App Group, общая для приложения и туннеля. Подписанной сборке нужна группа из её
// профиля: CI передаёт APP_GROUP_IDENTIFIER=... в xcodebuild.
APP_GROUP_IDENTIFIER = group.com.personaltunnelapp

// Ядро расширения: combined (sing-box + Xray-core, по умолчанию с 3.0.1) или singbox (только sing-box, как в 2.0.4).
TUNNEL_CORE = combined

// Коммит, из которого собран IPA; подставляет CI.
PERSONAL_SOURCE_COMMIT =

SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
ENABLE_USER_SCRIPT_SANDBOXING = NO
DEAD_CODE_STRIPPING = YES
SWIFT_COMPILATION_MODE = wholemodule
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
ENABLE_BITCODE = NO
