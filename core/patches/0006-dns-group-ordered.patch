diff --git a/dns/transport/group/ordered_lx_test.go b/dns/transport/group/ordered_lx_test.go
new file mode 100644
index 0000000..87487d0
--- /dev/null
+++ b/dns/transport/group/ordered_lx_test.go
@@ -0,0 +1,54 @@
+package group
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+)
+
+// lx: ordered — the first clean member in order is always asked first.
+func TestOrderedAsksTheFirstWhileItAnswers(t *testing.T) {
+	first := answering("doh")
+	second := answering("udp")
+	group := newTestGroup(t, ModeOrdered, time.Hour, 0, first, second)
+	for i := 0; i < 10; i++ {
+		_, err := group.Exchange(context.Background(), testQuery())
+		require.NoError(t, err)
+	}
+	require.Equal(t, int32(10), first.calls.Load())
+	require.Equal(t, int32(0), second.calls.Load())
+}
+
+// A broken first member: the query is rescued by the next one, the next
+// queries go to it while the error lives, and the first is asked again after.
+func TestOrderedFallsBackAndReturns(t *testing.T) {
+	broken := true
+	first := newFakeMember("doh", func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+		if broken {
+			return failing("x").exchange(ctx, message)
+		}
+		return okResponse(message), nil
+	})
+	second := answering("udp")
+	group := newTestGroup(t, ModeOrdered, 80*time.Millisecond, 0, first, second)
+
+	_, err := group.Exchange(context.Background(), testQuery())
+	require.NoError(t, err, "the fallback must answer the query the first one failed")
+	require.Equal(t, int32(1), first.calls.Load())
+	require.Equal(t, int32(1), second.calls.Load())
+
+	_, err = group.Exchange(context.Background(), testQuery())
+	require.NoError(t, err)
+	require.Equal(t, int32(1), first.calls.Load(), "a member with a live error is skipped")
+	require.Equal(t, int32(2), second.calls.Load())
+
+	broken = false
+	time.Sleep(120 * time.Millisecond)
+	_, err = group.Exchange(context.Background(), testQuery())
+	require.NoError(t, err)
+	require.Equal(t, int32(2), first.calls.Load(), "the first is asked again once its error expires")
+	require.Equal(t, int32(2), second.calls.Load())
+}
