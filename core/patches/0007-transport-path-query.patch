diff --git a/transport/v2raywebsocket/path_query_lx_test.go b/transport/v2raywebsocket/path_query_lx_test.go
new file mode 100644
index 0000000..2908edd
--- /dev/null
+++ b/transport/v2raywebsocket/path_query_lx_test.go
@@ -0,0 +1,29 @@
+package v2raywebsocket
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Personal Tunnel: a query in the path reaches the server as the query.
+func TestPathQueryLX(t *testing.T) {
+	for path, want := range map[string]string{
+		"/relay?token=abc&pool=de": "/relay?token=abc&pool=de",
+		"relay?x=1":                "/relay?x=1",
+		"/plain":                   "/plain",
+		"/a%2Fb":                   "/a%2Fb",
+	} {
+		transport, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("127.0.0.1:1"), option.V2RayWebsocketOptions{Path: path}, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		requestURL := transport.(*Client).requestURL
+		if got := requestURL.RequestURI(); got != want {
+			t.Errorf("%q: got %q, want %q", path, got, want)
+		}
+	}
+}
