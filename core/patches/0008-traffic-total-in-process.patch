+package libbox
+
+import "testing"
+
+// Personal Tunnel: without a service the totals are zero, not a crash.
+func TestTrafficTotalWithoutServiceLX(t *testing.T) {
+	total := (&CommandServer{}).TrafficTotal()
+	if total.Uplink != 0 || total.Downlink != 0 {
+		t.Fatalf("got %+v", total)
+	}
+}
