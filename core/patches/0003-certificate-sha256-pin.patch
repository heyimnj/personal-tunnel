new file mode 100644
index 0000000..554c69b
--- /dev/null
+++ b/common/tls/certificate_pin_lx.go
@@ -0,0 +1,100 @@
+package tls
+
+// lx:begin certificate-sha256
+// A server's own certificate pinned by its SHA-256 (Hysteria2 `pinSHA256`, Xray
+// `pinnedPeerCertSha256` / share-link `pcs`). Providers without a domain run
+// self-signed certificates and give clients this hash instead of `insecure`;
+// on iOS the system verifier rejects such a certificate outright ("not standards
+// compliant"), so without the pin the server could not be used at all.
+//
+// As Xray-core's verifyChain: the pin matching the leaf is enough. A pin matching
+// a certificate further up the chain counts only when that certificate is a CA
+// and the leaf verifies with it as the only root (and for the server's name).
+// Personal Tunnel 3.2 accepted any certificate of the chain: the pinned one is
+// public (the server sends it in every handshake), so a man in the middle could
+// present its own leaf followed by it (audit PT-03).
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/hex"
+	"strings"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// ParseCertificateSHA256 reads hex hashes; colons and spaces are ignored.
+func ParseCertificateSHA256(values []string) ([][]byte, error) {
+	hashes := make([][]byte, 0, len(values))
+	for _, value := range values {
+		clean := strings.NewReplacer(":", "", " ", "", "-", "").Replace(strings.TrimSpace(value))
+		decoded, err := hex.DecodeString(clean)
+		if err != nil || len(decoded) != sha256.Size {
+			return nil, E.New("invalid certificate_sha256: ", value)
+		}
+		hashes = append(hashes, decoded)
+	}
+	return hashes, nil
+}
+
+func pinned(known [][]byte, raw []byte) bool {
+	hash := sha256.Sum256(raw)
+	for _, value := range known {
+		if bytes.Equal(value, hash[:]) {
+			return true
+		}
+	}
+	return false
+}
+
+// VerifyCertificateSHA256 accepts the connection when the leaf has one of the
+// known hashes, or when a pinned CA of the presented chain issued the leaf for
+// serverName (no name check when serverName is empty).
+func VerifyCertificateSHA256(known [][]byte, rawCerts [][]byte, serverName string, now time.Time) error {
+	if len(rawCerts) == 0 {
+		return E.New("certificate pin: the server sent no certificate")
+	}
+	if pinned(known, rawCerts[0]) {
+		return nil
+	}
+	leafHash := sha256.Sum256(rawCerts[0])
+	unrecognized := E.New("certificate pin: unrecognized server certificate ", hex.EncodeToString(leafHash[:]))
+	leaf, err := x509.ParseCertificate(rawCerts[0])
+	if err != nil {
+		return unrecognized
+	}
+	for index, raw := range rawCerts[1:] {
+		if !pinned(known, raw) {
+			continue
+		}
+		authority, err := x509.ParseCertificate(raw)
+		if err != nil || !authority.IsCA {
+			continue
+		}
+		roots := x509.NewCertPool()
+		roots.AddCert(authority)
+		intermediates := x509.NewCertPool()
+		for other, item := range rawCerts[1:] {
+			if other == index {
+				continue
+			}
+			if certificate, err := x509.ParseCertificate(item); err == nil {
+				intermediates.AddCert(certificate)
+			}
+		}
+		if now.IsZero() {
+			now = time.Now()
+		}
+		options := x509.VerifyOptions{Roots: roots, Intermediates: intermediates, CurrentTime: now, DNSName: serverName, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny}}
+		if _, err := leaf.Verify(options); err == nil {
+			return nil
+		} else {
+			return E.Cause(err, "certificate pin: the pinned CA did not issue the server certificate")
+		}
+	}
+	return unrecognized
+}
+
+// lx:end
diff --git a/common/tls/certificate_pin_lx_test.go b/common/tls/certificate_pin_lx_test.go
new file mode 100644
index 0000000..56bec2b
--- /dev/null
+++ b/common/tls/certificate_pin_lx_test.go
@@ -0,0 +1,212 @@
+package tls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	stdtls "crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/hex"
+	"math/big"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+type testCert struct {
+	der  []byte
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+}
+
+// newTestCert makes a certificate for name, signed by parent (self-signed when nil).
+func newTestCert(t *testing.T, name string, isCA bool, parent *testCert) testCert {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serial, _ := rand.Int(rand.Reader, big.NewInt(1<<62))
+	template := &x509.Certificate{
+		SerialNumber: serial, Subject: pkix.Name{CommonName: name},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(24 * time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		BasicConstraintsValid: true, IsCA: isCA,
+	}
+	if !isCA {
+		template.DNSNames = []string{name}
+	}
+	signer, signerKey := template, key
+	if parent != nil {
+		signer, signerKey = parent.cert, parent.key
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, signer, &key.PublicKey, signerKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, _ := x509.ParseCertificate(der)
+	return testCert{der: der, cert: cert, key: key}
+}
+
+func pinOf(der []byte) [][]byte {
+	hash := sha256.Sum256(der)
+	return [][]byte{hash[:]}
+}
+
+func TestCertificateSHA256Pin(t *testing.T) {
+	genuine := newTestCert(t, "example.internal", false, nil)
+	attacker := newTestCert(t, "example.internal", false, nil)
+	authority := newTestCert(t, "Panel CA", true, nil)
+	issued := newTestCert(t, "example.internal", false, &authority)
+	otherCA := newTestCert(t, "Other CA", true, nil)
+	now := time.Now()
+
+	hash := sha256.Sum256(genuine.der)
+	colons := ""
+	for i, b := range hash {
+		if i > 0 {
+			colons += ":"
+		}
+		colons += hex.EncodeToString([]byte{b})
+	}
+	known, err := ParseCertificateSHA256([]string{colons})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyCertificateSHA256(known, [][]byte{genuine.der}, "example.internal", now); err != nil {
+		t.Fatal("leaf pin rejected:", err)
+	}
+	// PT-03: someone else's leaf followed by the pinned certificate.
+	if err := VerifyCertificateSHA256(known, [][]byte{attacker.der, genuine.der}, "example.internal", now); err == nil {
+		t.Fatal("a chain [someone else's leaf, pinned certificate] was accepted")
+	}
+	// A pinned CA counts only for a leaf it issued, for the server's name.
+	caPin := pinOf(authority.der)
+	if err := VerifyCertificateSHA256(caPin, [][]byte{issued.der, authority.der}, "example.internal", now); err != nil {
+		t.Fatal("leaf issued by the pinned CA rejected:", err)
+	}
+	if err := VerifyCertificateSHA256(caPin, [][]byte{attacker.der, authority.der}, "example.internal", now); err == nil {
+		t.Fatal("a leaf the pinned CA did not issue was accepted")
+	}
+	if err := VerifyCertificateSHA256(caPin, [][]byte{issued.der, authority.der}, "other.internal", now); err == nil {
+		t.Fatal("the pinned CA's leaf was accepted for another name")
+	}
+	if err := VerifyCertificateSHA256(caPin, [][]byte{issued.der, otherCA.der}, "example.internal", now); err == nil {
+		t.Fatal("a chain without the pinned CA was accepted")
+	}
+	// A pinned certificate that is not a CA does not vouch for another leaf.
+	if err := VerifyCertificateSHA256(pinOf(genuine.der), [][]byte{issued.der, genuine.der}, "example.internal", now); err == nil {
+		t.Fatal("a non-CA pinned certificate vouched for another leaf")
+	}
+	if err := VerifyCertificateSHA256(known, nil, "", now); err == nil {
+		t.Fatal("empty chain accepted")
+	}
+	if _, err := ParseCertificateSHA256([]string{"abcd"}); err == nil {
+		t.Fatal("short hash accepted")
+	}
+	if _, err := ParseCertificateSHA256([]string{"zz"}); err == nil {
+		t.Fatal("non-hex hash accepted")
+	}
+}
+
+// startTLSServer serves TLS with the given chain (leaf first) and key, once per connection.
+func startTLSServer(t *testing.T, chain [][]byte, key *ecdsa.PrivateKey) string {
+	t.Helper()
+	listener, err := stdtls.Listen("tcp", "127.0.0.1:0", &stdtls.Config{Certificates: []stdtls.Certificate{{Certificate: chain, PrivateKey: key}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				_ = conn.(*stdtls.Conn).Handshake()
+			}()
+		}
+	}()
+	return listener.Addr().String()
+}
+
+func pinHandshake(t *testing.T, address string, options option.OutboundTLSOptions) error {
+	t.Helper()
+	config, err := NewClient(context.Background(), log.NewNOPFactory().Logger(), "example.internal", options)
+	if err != nil {
+		return err
+	}
+	conn, err := net.Dial("tcp", address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	tlsConn, err := ClientHandshake(context.Background(), conn, config)
+	if err != nil {
+		return err
+	}
+	return tlsConn.Close()
+}
+
+// Real handshakes, standard and uTLS engines: the pinned server gets through, a
+// man in the middle that appends the pinned certificate to its own does not
+// (PT-03), a wrong hash does not, `insecure` does not switch the pin off, and
+// without a pin the ordinary verification still refuses a self-signed server.
+func TestCertificateSHA256PinHandshake(t *testing.T) {
+	genuine := newTestCert(t, "example.internal", false, nil)
+	attacker := newTestCert(t, "example.internal", false, nil)
+	authority := newTestCert(t, "Panel CA", true, nil)
+	issued := newTestCert(t, "example.internal", false, &authority)
+	server := startTLSServer(t, [][]byte{genuine.der}, genuine.key)
+	middle := startTLSServer(t, [][]byte{attacker.der, genuine.der}, attacker.key)
+	panel := startTLSServer(t, [][]byte{issued.der, authority.der}, issued.key)
+	forged := startTLSServer(t, [][]byte{attacker.der, authority.der}, attacker.key)
+	good := hex.EncodeToString(pinOf(genuine.der)[0])
+	caPin := hex.EncodeToString(pinOf(authority.der)[0])
+	bad := strings.Repeat("00", 32)
+
+	for _, fingerprint := range []string{"", "chrome"} {
+		base := option.OutboundTLSOptions{Enabled: true, ServerName: "example.internal"}
+		if fingerprint != "" {
+			base.UTLS = &option.OutboundUTLSOptions{Enabled: true, Fingerprint: fingerprint}
+		}
+		pinned := base
+		pinned.CertificateSHA256 = []string{good}
+		if err := pinHandshake(t, server, pinned); err != nil {
+			t.Fatalf("pinned handshake (%q) failed: %v", fingerprint, err)
+		}
+		if err := pinHandshake(t, middle, pinned); err == nil {
+			t.Fatalf("(%q) a man in the middle with the pinned certificate appended was accepted", fingerprint)
+		}
+		withCA := base
+		withCA.CertificateSHA256 = []string{caPin}
+		if err := pinHandshake(t, panel, withCA); err != nil {
+			t.Fatalf("(%q) leaf of the pinned CA rejected: %v", fingerprint, err)
+		}
+		if err := pinHandshake(t, forged, withCA); err == nil {
+			t.Fatalf("(%q) a leaf the pinned CA did not issue was accepted", fingerprint)
+		}
+		wrong := base
+		wrong.CertificateSHA256 = []string{bad}
+		if err := pinHandshake(t, server, wrong); err == nil {
+			t.Fatalf("wrong pin (%q) accepted", fingerprint)
+		}
+		insecure := wrong
+		insecure.Insecure = true
+		if err := pinHandshake(t, server, insecure); err == nil {
+			t.Fatalf("(%q) insecure switched the pin off", fingerprint)
+		}
+		if err := pinHandshake(t, server, base); err == nil {
+			t.Fatalf("unpinned self-signed server (%q) accepted", fingerprint)
+		}
+	}
+}
